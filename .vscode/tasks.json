{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: gcc.exe 构建项目（多文件）",
            "command": "C:\\Program Files\\x86_64-8.1.0-release-posix-seh-rt_v6-rev0\\mingw64\\bin\\gcc.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${fileDirname}\\*.c",
                "-o",
                "${fileDirname}\\main.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "编译所有 .c 文件并链接为 main.exe"
        }
    ],
    "version": "2.0.0"
}